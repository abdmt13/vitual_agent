# Aplicación y Servidor
APP_NAME="Chatbot IA Backend"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=INFO

# Base de Datos MySQL (SQLAlchemy 2.0 Async)
DB_HOST=127.0.0.2
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345
DB_NAME=agentevirtualmvp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
# Opcional URL directa (ej. sqlite+aiosqlite:///./test.db o mysql+asyncmy://...)
# DATABASE_URL=mysql+asyncmy://root:12345@127.0.0.2:3306/agentevirtualmvp?charset=utf8mb4

# Seguridad y Autenticación JWT Stateless
JWT_SECRET_KEY=super-secret-jwt-key-for-clean-architecture-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Cache (Opcional - con fallback automático en memoria si está deshabilitado)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Kafka Messaging (Opcional - con fallback automático a logs si está deshabilitado)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
KAFKA_TOPIC_CHAT_EVENTS=chatbot-chat-events
KAFKA_TOPIC_AUTH_EVENTS=chatbot-auth-events

# Proveedor de Inteligencia Artificial (gemini o openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_MS=15000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Instrucciones del Bot
BOT_INSTRUCTIONS=Eres el asistente virtual de Mi Negocio. Responde en español, con amabilidad y claridad. No inventes precios, políticas ni datos. Si no tienes información suficiente, dilo y ofrece transferir la conversación a una persona.
